{
  "name": "agents-memo",
  "version": "2.5.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Obsidian wiki plugin for pi coding agent — personal knowledge vault with LLM-assisted ingestion, research, and retrieval.",
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "obsidian",
    "wiki",
    "knowledge-base",
    "memory"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misiekhardcore/agents-memo.git"
  },
  "homepage": "https://github.com/misiekhardcore/agents-memo#readme",
  "bugs": {
    "url": "https://github.com/misiekhardcore/agents-memo/issues"
  },
  "pi": {
    "extensions": [
      "./dist/agents-memo.js",
      "./dist/agents.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "dist/",
    "_shared/",
    "scripts/",
    "agents/",
    "skills/",
    "_templates/",
    "_seed/",
    "bin/"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsup",
    "test": "pnpm run test:smoke && vitest run",
    "test:vitest": "vitest run",
    "test:watch": "vitest --watch",
    "test:smoke": "bash tests/cli-smoke.sh && bash tests/regression/daily-append.sh && bash tests/regression/read-canvas.sh && bash tests/regression/hot-cache-guard.sh && bash tests/regression/pi-settings-tier.sh && bash tests/regression/prune-lint-guard.sh && bash tests/regression/index-section-insert.sh && bash tests/regression/lint-duplicate-headings.sh",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "format:md:check": "bin/minify-md --check",
    "format:md:fix": "bin/minify-md --write",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "changelog": "git-cliff -o CHANGELOG.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@eslint/js": "10.0.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.10.1",
    "tsup": "^9.0.0",
    "typebox": "^1.4.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "bin/minify-md --write"
    ]
  }
}
