{
  "name": "agents-memo",
  "version": "2.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "format:check": "bin/minify-md --check",
    "format:fix": "bin/minify-md --write",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@mariozechner/pi-ai": "^0.73.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "git-cliff": "^2.13.1",
    "husky": "^9.1",
    "jiti": "^2.7.0",
    "lint-staged": "^15.5",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.md": [
      "bin/minify-md --write"
    ]
  }
}
